# Copy this file to .env and fill in the values before running.
# .env is git-ignored; never commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ccr:ccr@localhost:5432/ccr

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Market data ───────────────────────────────────────────────────────────────
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Email alerts (optional) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ccr-alerts@example.com

# ── Scheduler killswitch ──────────────────────────────────────────────────────
# Set to false to disable all background jobs without redeploying.
# Useful during incidents or when running isolated tests.
SCHEDULER_ENABLED=true

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to true to log all SQL statements (very verbose).
DEBUG_SQL=false
